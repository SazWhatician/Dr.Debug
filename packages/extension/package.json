{
  "name": "@dr-debug/extension",
  "version": "0.1.0",
  "description": "Chrome Extension and Dedicated DevTools Panel for Dr. Debug",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@dr-debug/controller": "*",
    "@dr-debug/core": "*",
    "@dr-debug/llms": "*",
    "@dr-debug/ui": "*",
    "dr-debug": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["chrome-extension", "devtools", "debugging", "agent", "ai"],
  "author": "Dr. Debug Team",
  "license": "MIT"
}
