{
  "name": "@dr-debug/extension",
  "version": "0.1.0",
  "description": "Chrome Extension and Dedicated DevTools Panel for Dr. Debug",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@dr-debug/controller": "*",
    "@dr-debug/core": "*",
    "@dr-debug/llms": "*",
    "@dr-debug/ui": "*",
    "dr-debug": "*"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chrome-extension",
    "devtools",
    "debugging",
    "agent",
    "ai"
  ],
  "author": "Saswat Kumar Mohanty (AI/ML Engineer, VSSUT Burla, Bhubaneswar)",
  "license": "MIT"
}
