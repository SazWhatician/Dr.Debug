{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@dr-debug/controller": ["packages/controller/src/index.ts"],
      "@dr-debug/llms": ["packages/llms/src/index.ts"],
      "@dr-debug/core": ["packages/core/src/index.ts"],
      "@dr-debug/ui": ["packages/ui/src/index.ts"],
      "@dr-debug/extension": ["packages/extension/src/index.ts"],
      "dr-debug": ["packages/dr-debug/src/index.ts"]
    }
  }
}
