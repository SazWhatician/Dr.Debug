{
  "name": "dr-debug-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous in-browser AI debugging & observability agent",
  "author": "Saswat Kumar Mohanty (AI/ML Engineer, VSSUT Burla, Bhubaneswar)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build:extension": "node scripts/build-extension.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b tsconfig.build.json && npm run build:extension",
    "typecheck": "tsc --noEmit",
    "clean": "tsc -b tsconfig.build.json --clean",
    "preview": "vite preview"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "happy-dom": "^15.11.7",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
